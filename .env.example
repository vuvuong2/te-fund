# The Supabase Postgres behind the Fund. Until this is set the app renders its
# "not connected" state rather than failing — see src/lib/db.server.ts.
# Use the session pooler connection string from Supabase → Project Settings → Database.
DATABASE_URL=

# Google is the only sign-in provider. These two are read by the Supabase CLI
# (supabase/config.toml) for a local stack; the hosted project keeps its own copy
# under Authentication → Providers.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
